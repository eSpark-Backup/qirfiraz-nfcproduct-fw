static uint32_t NFC_Cmd_0x72_GetShippingID(uint8_t msgId, int len, const uint8_t* pPyld){
	NFC_CMD_0x72_RES_T res;

	Chip_EEPROM_Read(NSS_EEPROM, NFC_REG_SHIPPING_ID_OFFSET, &res.length, sizeof(uint8_t));

	Chip_EEPROM_Read(NSS_EEPROM, NFC_REG_SHIPPING_ID_OFFSET + 1, res.shipping_id, sizeof(uint8_t) * NFC_REG_SHIPPING_ID_LENGTH);

	res.success = NFC_CMD_RES_OK;

	Msg_AddResponse(msgId, sizeof(uint8_t) * (2 + res.length), (uint8_t*) &res);

	return MSG_OK;
}

//	Command 0x73: Get the actual sensor information
//	Query
//	uint8_t  msgId = 0x73;              //Read actual sensor information
//	uint8_t  msgDirection = 0x00;		//Reserved code (0x00=send, 0x01=receive)
//
//	Response
//	uint8_t  msgId = 0x73;              //Read actual sensor information
//	uint8_t  msgDirection = 0x01;		//Reserved code (0x00=send, 0x01=receive)
//	uint8_t  responseResult;            //Confirmation (0x01=OK, 0x00=ERROR)
//	int16_t  acc_x;				// X-axis acceleration
//	int16_t  acc_y;				// Y-axis acceleration
//	int16_t  acc_z;				// Z-axis acceleration
//	uint8_t  temp;				// Temperature(-40 to + 85°C)
//	uint8_t  batteryVoltage;            // 0 to 255 (representing 0V to 3.825V)
//
//  OK, tested

static uint32_t NFC_Cmd_0x73_GetActualSensorInfo(uint8_t msgId, int len, const uint8_t* pPyld){
	NFC_CMD_0x73_RES_T res;

	MEMS_ACC_DATA_T acc = MEMS_SingleReadAcceleration();

	res.accX = (int8_t) (acc.x >> 8);
	res.accY = (int8_t) (acc.y >> 8);
	res.accZ = (int8_t) (acc.z >> 8);

	Chip_TSen_Start(NSS_TSEN);

	while(!(Chip_TSen_ReadStatus(NSS_TSEN, NULL) & TSEN_STATUS_MEASUREMENT_DONE)){}

	res.temp = (int8_t)Chip_TSen_NativeToCelsius(Chip_TSen_GetValue(NSS_TSEN), 1);

	res.volt = (uint8_t) 223;

	res.success = NFC_CMD_RES_OK;

	Msg_AddResponse(msgId, sizeof(res), (uint8_t*) &res);

	return MSG_OK;
}


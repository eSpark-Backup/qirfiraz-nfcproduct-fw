static uint32_t NFC_Cmd_0x80_RequestSecureCommunications(uint8_t msgId, int len, const uint8_t* pPyld){
	NFC_CMD_0x80_RES_T res;
	int i;

	srand(Chip_RTC_Time_GetValue(NSS_RTC));

	int getRandNum(int lower, int upper){
		int res = (rand() % (upper - lower + 1)) + lower;

		return res;
	}

	res.securityScheme = 0;

	res.keyLength = getRandNum(8, 32);

	for(i = 0; i < res.keyLength; i++){
		res.key[i] = getRandNum(0, 255);
	}

	res.success = NFC_CMD_RES_OK;

	Msg_AddResponse(msgId, sizeof(res) - (32 - res.keyLength), (uint8_t*) &res);

	return MSG_OK;
}

static bool NFC_MsgResponse_Cb(int resLen, const uint8_t* pResData){
	NDEFT2T_CreateMessage(sNdefInstTx, sTxData,sizeof(sTxData), true);

	NDEFT2T_CREATE_RECORD_INFO_T recInfo = {(uint8_t*)"nhs31xx/example.ndef", resLen <= 255, 0};

	if(NDEFT2T_CreateMimeRecord(sNdefInstTx, &recInfo)){
		if(resLen && NDEFT2T_WriteRecordPayload(sNdefInstTx, pResData, resLen))
			NDEFT2T_CommitRecord(sNdefInstTx);
	}

	NDEFT2T_CommitMessage(sNdefInstTx);

	return true;
}

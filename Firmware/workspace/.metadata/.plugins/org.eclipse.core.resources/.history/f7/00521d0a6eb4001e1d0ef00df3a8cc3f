//	Command 0x77: Start logging alerts
//	The commandDelayMin field allows a delay after this command is received, before the start of logging. The range is expressed in minutes, from 0 for no delay to 65535 for 45.5 days.
//
//	Query
//	uint8_t  msgId = 0x77;              //Start logging alerts
//	uint8_t  msgDirection = 0x00;		//Reserved code (0x00=send, 0x01=receive)
//	uint16_t commandDelayMin;		// Delay in minutes before logging starts
//	uint32_t logStartTime;              // Start of logging timestamp (App time)
//
//	Response
//	uint8_t  msgId = 0x77;              //Start logging alerts
//	uint8_t  msgDirection = 0x01;		//Reserved code (0x00=send, 0x01=receive)
//	uint8_t  responseResult;            //Confirmation (0x01=OK, 0x00=ERROR)

//
//	TODO
//  - na zaklade nastaveni nakonfigurovat senzor a interrupty. v pripade cyklickeho merania aj casovac.
//  - potom do mainu treba dat podmienky ak sa zobudi casovacom alebo prerusenim tak spravi log a to je vlastne vsetko, inak logy robit nebude
//  - nakoniec nejak vymysliet ako spravit ten odlozeny start - mozno len podmienkou ze log spravi len ked je cas vacsi ako je cas odlozeneho startu
//  - ak by bol cyklicky rezim tak sa vlastne za kazdym zobudenim casovacom znova bude musiet nastavit (asi tak to funguje)
//	- temperature threshold settings
//	- a tiez ukladat cas logStartTime (App time)

static uint32_t NFC_Cmd_0x77_StartLogging(uint8_t msgId, int len, const uint8_t* pPyld){
	// počas ostrej prevádzky vznika problem ak po start loggingu dam vycitat data so senzora - prestavi mi nastavenia - treba to nejak osetrit
	//

	NFC_CMD_0x71_RES_T res;
	NFC_REG_LOGGING_STATUS_T logStatus;
	NFC_REG_SENSOR_SETTINGS_T sensSettings;

	Chip_EEPROM_Read(NSS_EEPROM, NFC_REG_SENSOR_SETTINGS_OFFSET, (uint8_t*) &sensSettings, NFC_REG_SENSOR_SETTINGS_LENGTH);

	Chip_EEPROM_Read(NSS_EEPROM, NFC_REG_LOGGING_STATUS_OFFSET, (uint8_t*) &logStatus, NFC_REG_LOGGING_STATUS_LENGTH);

//	odlozeny delay sa spravi len tak ze sa nastavi casovac (commandDelayMin * 60) a po zobudeni zisti ze v registri _NFC_REG_LOGGING_STATUS je nastaveny priznak postponed
//	tak vlastne spravi vsetko co robi command 77 - cize asi sa jadro commandu (v podmienke status.running) osamostatni do funkcie

	if(logStatus.running == NFC_STOPPED){
		if(sensSettings.measure_interval >= 30){
			NVIC_EnableIRQ(RTC_IRQn);
			Chip_RTC_Wakeup_SetReload(NSS_RTC, sensSettings.measure_interval);
		}

		logStatus.running = NFC_RUNNING;

//		for(int i = 0; i < 4; i++){
//			res.logStartTime[i] = log.timeStamp[i];
//		}

		for(int i = 0; i < 4; i++){
			logStatus.logStartTime[i] = pPyld[i + 2];
		}

		Chip_EEPROM_Write(NSS_EEPROM, NFC_REG_LOGGING_STATUS_OFFSET, (uint8_t*) &logStatus, NFC_REG_LOGGING_STATUS_LENGTH);

		Chip_RTC_Time_SetValue(NSS_RTC, 0);

		MEMS_ThresholdSet();

		NVIC_EnableIRQ(PIO0_IRQn);

//		Chip_GPIO_EnableInt(NSS_GPIO, MEMS_SIGNAL_PORT, NSS_GPIOn_PINMASK(MEMS_SIGNAL_INT1));

		res.success = NFC_CMD_RES_OK;
	}else{
		res.success = NFC_CMD_RES_LOGGING_ALREADY_RUNNING;
	}




	Msg_AddResponse(msgId, sizeof(res), (uint8_t*)&res);

	return MSG_OK;
}

//	Command 0x78: Stop logging alerts
//	Query
//	uint8_t  msgId = 0x78;              //Stop logging alerts
//	uint8_t  msgDirection = 0x00;		//Reserved code (0x00=send, 0x01=receive)
//
//	Response
//	uint8_t  msgId = 0x78;              //Stop logging alerts
//	uint8_t  msgDirection = 0x01;		//Reserved code (0x00=send, 0x01=receive)
//	uint8_t  responseResult;            //Confirmation (0x01=OK, 0x00=ERROR)
//
//	TODO
//	- deinicializovat casovace
//	- test with app

static uint32_t NFC_Cmd_0x78_StopLogging(uint8_t msgId, int len, const uint8_t* pPyld){
	// tuto treba dat pozor ked sa bude prechadzat do deep down aby sa deinicializoval Storage


	NFC_CMD_0x78_RES_T res;
	NFC_REG_LOGGING_STATUS_T logStatus;

	Chip_EEPROM_Read(NSS_EEPROM, NFC_REG_LOGGING_STATUS_OFFSET, (uint8_t*) &logStatus, NFC_REG_LOGGING_STATUS_LENGTH);

	if(logStatus.running == NFC_RUNNING){
		logStatus.running = NFC_STOPPED;
		logStatus.postponed = NFC_STOPPED;

		NVIC_DisableIRQ(RTC_IRQn);

		MEMS_RestoreDefault();

		NVIC_DisableIRQ(PIO0_IRQn);

//		Chip_GPIO_DisableInt(NSS_GPIO, MEMS_SIGNAL_PORT, NSS_GPIOn_PINMASK(MEMS_SIGNAL_INT1));

		Chip_EEPROM_Write(NSS_EEPROM, NFC_REG_LOGGING_STATUS_OFFSET, (uint8_t*) &logStatus, NFC_REG_LOGGING_STATUS_LENGTH);

		Storage_DeInit();

		res.success = NFC_CMD_RES_OK;
	}else{
		res.success = NFC_CMD_RES_LOGGING_ALREADY_STOPPED;
	}

	Msg_AddResponse(msgId, sizeof(res), (uint8_t*) &res);

	return MSG_OK;
}

//Command 0x79: Get a log record
//Query
//uint8_t  msgId = 0x79;              //Read the log
//uint8_t  msgDirection = 0x00;		//Reserved code (0x00=send, 0x01=receive)
//uint16_t startFrom;			// Record number to read (0 to 65535)
//
//Response
//uint8_t  msgId = 0x79;              //Read the log
//uint8_t  msgDirection = 0x01;		//Reserved code (0x00=send, 0x01=receive)
//uint8_t  responseResult;            //Confirmation 0x01=OK
//									//             0x00=ERROR
//									//             0x02=END_OF_FILE
//									//             0x03=INVALID_DATA
//uint16_t fileSize;			// Number of log records in file
//uint16_t recordNumber;			// This record number
//int8_t   acc_x;				// X-axis acceleration
//int8_t   acc_y;				// Y-axis acceleration
//int8_t   acc_z;				// Z-axis acceleration
//uint8_t  temp;				// Temperature
//uint32_t timeStamp;			// Measurement timestamp
//
//

static uint32_t NFC_Cmd_0x79_GetLogRecord(uint8_t msgId, int len, const uint8_t* pPyld){
	NFC_CMD_0x79_RES_T res;

//	uint8_t a = pPyld[0];	- moze sa vymazat
//	uint8_t b = pPyld[1];	- moze sa vymazat

	uint16_t startFrom = pPyld[1] | (pPyld[0] << 8);

	uint16_t fileSize = (uint16_t) Storage_GetCount();

	LOGS_LOG_T logPacked;
	NFC_LOG_T log;

	int readLogs = 0;
	bool seekSucced = false;

	res.fileSize[0] = fileSize;
	res.fileSize[1] = fileSize >> 8;

	res.recNumber[0] = startFrom;
	res.recNumber[1] = startFrom >> 8;

	seekSucced = Storage_Seek((int) startFrom);

	if(seekSucced){
		readLogs = Storage_Read(&logPacked, 1);

		if(readLogs == 1){
			log = Logs_UnpackData(logPacked);

			res.accX = log.accX;
			res.accY = log.accY;
			res.accZ = log.accZ;
			res.temp = log.temp;
			res.timeStamp[0] = log.timeStamp[0];
			res.timeStamp[1] = log.timeStamp[1];
			res.timeStamp[2] = log.timeStamp[2];
			res.timeStamp[3] = log.timeStamp[3];

			res.success = NFC_CMD_RES_OK;
		}else
			res.success = NFC_CMD_RES_END_OF_FILE;
	}else
		res.success = NFC_CMD_RES_INVALID_DATA;

	Msg_AddResponse(msgId, sizeof(res), (uint8_t*) &res);

	return MSG_OK;
}


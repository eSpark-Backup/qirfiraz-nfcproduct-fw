	NFC_HandleRx();
}

void NFC_Init(void){
	Chip_NFC_Init(NSS_NFC);

	NDEFT2T_Init();

	Msg_Init();
	Msg_SetResponseCb(NFC_MsgResponse_Cb);

	// zvazit odseparovanie do log - u - pripadne inicializovat az kd to je treba, bezprostredne pred pouzitim
	Chip_TSen_Init(NSS_TSEN);
	Chip_TSen_SetResolution(NSS_TSEN, TSEN_7BITS);

	// aj toto sa pouziva v NFC aj MEMS, tak to dat asi dlo globalu
	Chip_RTC_Init(NSS_RTC);
	Chip_RTC_Wakeup_SetControl(NSS_RTC, RTC_WAKEUPCTRL_ENABLE | RTC_WAKEUPCTRL_AUTO);
	Chip_RTC_Int_SetEnabledMask(NSS_RTC, RTC_INT_ALL);

	// docasne vymazanie priznaku behu logovania
	NFC_REG_LOGGING_STATUS_T logStatus;

	Chip_EEPROM_Read(NSS_EEPROM, NFC_REG_LOGGING_STATUS_OFFSET, (uint8_t*) &logStatus, NFC_REG_LOGGING_STATUS_LENGTH);

	logStatus.running = NFC_STOPPED;

	Chip_EEPROM_Write(NSS_EEPROM, NFC_REG_LOGGING_STATUS_OFFSET, (uint8_t*) &logStatus, NFC_REG_LOGGING_STATUS_LENGTH);
}

static void NFC_HandleRx(void){
	if(NDEFT2T_GetMessage(sNdefInstRx,sRxData, sizeof(sRxData))){
		uint8_t *pPyld;
		int len;

		NDEFT2T_PARSE_RECORD_INFO_T recInfo;

		while(NDEFT2T_GetNextRecord(sNdefInstRx, &recInfo)){
			if(recInfo.type == NDEFT2T_RECORD_TYPE_MIME){
				pPyld = NDEFT2T_GetRecordPayload(sNdefInstRx, &len);
				Msg_HandleCommand(len, pPyld);
			}
		}
	}
}

//	Command 0x70: Get the unique tag ID
//	Query
//	uint8_t  msgId = 0x70;		      //Read unique tag ID
//	uint8_t  msgDirection = 0x00;		//Reserved code (0x00=send, 0x01=receive)
//
//	Response
//	uint8_t  msgId = 0x70;		      //Read unique tag ID
//	uint8_t  msgDirection = 0x01;		//Reserved code (0x00=send, 0x01=receive)
//	uint8_t  responseResult;            //Confirmation (0x01=OK, 0x00=ERROR)
//	uint32_t  tag_id[4];			// Tag ID in hexadecimal
//
// 	OK, tested

static uint32_t NFC_Cmd_0x70_GetUniqeTagID(uint8_t msgId, int len, const uint8_t* pPyld){
	NFC_CMD_0x70_RES_T res;

	uint32_t uid[4];

	Chip_IAP_ReadUID(uid);

	for(int i = 0; i < 16; i++){
		res.uid[i] = ((uint8_t *) &uid)[i];
	}

	res.success = NFC_CMD_RES_OK;

	Msg_AddResponse(msgId, sizeof(res), (uint8_t*) &res);

	return MSG_OK;
}


static uint32_t NFC_Cmd_0x71_SetShippingID(uint8_t msgId, int len, const uint8_t* pPyld){
	NFC_CMD_0x71_RES_T res;

	Chip_EEPROM_Write(NSS_EEPROM, NFC_REG_SHIPPING_ID_OFFSET, pPyld, sizeof(uint8_t) * pPyld[0] + 1);

	Chip_EEPROM_Flush(NSS_EEPROM, false);

	res.success = NFC_CMD_RES_OK;

	Msg_AddResponse(msgId, sizeof(res), (uint8_t*) &res);

	return MSG_OK;
}

